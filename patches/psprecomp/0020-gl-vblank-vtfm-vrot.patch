+
+static void *cmd_add(uint32_t op, size_t size) {
+    size = (size + 7) & ~(size_t)7;
+    chead *h = (chead *)gbuf_add(&g_frames[g_rec].cmd, size);
+    memset(h, 0, size);
+    h->op = op;
+    h->size = (uint32_t)size;
+    return h;
+}
