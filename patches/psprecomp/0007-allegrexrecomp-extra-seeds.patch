 /* Load a decrypted module and run discovery over it. On success the caller
  * owns both `b` (psp_blob_free) and `an` (a_analysis_free). Shared by `funcs`
  * and `emit`, which differ only in what they do with the result. */
+/* --seeds FILE: extra function entries, one hex address per line ('#' starts
+ * a comment). For code that nothing inside the module reaches -- a function
+ * only ever called from an overlay the game loads at run time is invisible to
+ * discovery over the module alone. Seeds outside the image are ignored. */
+static const char *g_seeds_path;
+
+static int read_extra_seeds(uint32_t lo, uint32_t hi, uint32_t **out) {
+    *out = NULL;
+    if (!g_seeds_path) return 0;
+    FILE *f = fopen(g_seeds_path, "r");
+    if (!f) { fprintf(stderr, "cannot read seeds file %s\n", g_seeds_path); return -1; }
+    int n = 0, cap = 0, skipped = 0;
+    char line[128];
+    while (fgets(line, sizeof line, f)) {
+        char *hash = strchr(line, '#');
+        if (hash) *hash = '\0';
+        char *end;
+        unsigned long v = strtoul(line, &end, 16);
+        if (end == line) continue;
+        uint32_t a = (uint32_t)v;
+        if (a < lo || a >= hi || (a & 3)) { skipped++; continue; }
+        if (n == cap) {
+            cap = cap ? cap * 2 : 256;
+            uint32_t *bigger = (uint32_t *)realloc(*out, (size_t)cap * sizeof **out);
+            if (!bigger) { fclose(f); free(*out); *out = NULL; return -1; }
+            *out = bigger;
+        }
+        (*out)[n++] = a;
+    }
+    fclose(f);
+    printf("extra seeds: %d from %s (%d outside the image, ignored)\n", n, g_seeds_path, skipped);
+    return n;
+}
