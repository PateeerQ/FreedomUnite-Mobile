+static int iso_name_eq(const uint8_t *name, int len, const char *comp, size_t clen) {
+    const uint8_t *semi = memchr(name, ';', (size_t)len);
+    if (semi) len = (int)(semi - name);
+    if (len > 0 && name[len - 1] == '.') len--;
