+int psp_callback_notify(uint32_t uid, uint32_t arg) {
+    psp_callback *c = find_callback(uid);
+    if (!c) return -1;
+    c->notify_arg = arg;
+    if (c->notify_count < 0x7FFFFFFF) c->notify_count++;
+    return 0;
+}
