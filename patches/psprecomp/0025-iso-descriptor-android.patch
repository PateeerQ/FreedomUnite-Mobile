@@ -118,6 +118,51 @@ typedef struct {
 
 static iso_entry g_iso_root;
 
+#ifdef __ANDROID__
+#include <stdlib.h>
+#include <unistd.h>
+
+/* A disc the app handed over as an open descriptor, "/proc/self/fd/N" (a
+ * file the player chose through Android's file picker). Opening that path
+ * again would go back through the shared storage's permission check, which
+ * the app does not pass (it has the descriptor, not the folder), so each
+ * open reads the one descriptor with pread at a position of its own. */
+typedef struct { int fd; int64_t pos; } fd_reader;
+
+static int fd_read(void *c, char *buf, int n) {
+    fd_reader *r = (fd_reader *)c;
+    ssize_t got = pread(r->fd, buf, (size_t)n, (off_t)r->pos);
+    if (got > 0) r->pos += got;
+    return (int)got;
+}
+
+static fpos_t fd_seek(void *c, fpos_t off, int whence) {
+    fd_reader *r = (fd_reader *)c;
+    int64_t base = whence == SEEK_SET ? 0 : whence == SEEK_CUR ? r->pos : (int64_t)lseek(r->fd, 0, SEEK_END);
+    if (base + (int64_t)off < 0) return -1;
+    r->pos = base + (int64_t)off;
+    return (fpos_t)r->pos;
+}
+
+static int fd_close(void *c) { free(c); return 0; }
+
+static FILE *iso_open(const char *path) {
+    int fd;
+    char tail;
+    if (sscanf(path, "/proc/self/fd/%d%c", &fd, &tail) == 1) {
+        fd_reader *r = (fd_reader *)calloc(1, sizeof *r);
+        if (!r) return NULL;
+        r->fd = fd;
+        FILE *f = funopen(r, fd_read, NULL, fd_seek, fd_close);
+        if (!f) free(r);
+        return f;
+    }
+    return fopen(path, "rb");
+}
+#else
+static FILE *iso_open(const char *path) { return fopen(path, "rb"); }
+#endif
+
 static int iso_read(FILE *f, uint32_t lbn, uint8_t *buf) {
     if (io_seek(f, (int64_t)lbn * SECTOR, SEEK_SET) != 0) return -1;
     return fread(buf, 1, SECTOR, f) == SECTOR ? 0 : -1;
