# Build output
build/
out/
*.obj
*.exe
*.pdb
*.ilk
*.log

# Everything made from the game: extracted disc, decrypted EBOOT, emitted C,
# captures. Never committed.
work/
mhfu/

# Game data is never committed -- bring your own dump
*.iso
*.cso
*.7z
*.zip
*.pbp
*.prx
EBOOT.BIN
*_EBOOT.BIN
BOOT.BIN
DATA.BIN
*.ppm

# PSP decryption keys are not distributed -- supply your own
keys/
*.keys

# Third-party binaries fetched for the build (FFmpeg); see CMakeLists.txt
deps/

# Loose psprecomp download (the submodule at psprecomp/ replaces it)
psprecomp-*/

# Android: Gradle state, the NDK build, and the APK -- which holds code
# recompiled from your own EBOOT, so it is never committed or shared
.gradle/
local.properties
android/app/.cxx/
*.apk
*.aab

# Editor / OS
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
__pycache__/

# Miscellaneous
CLAUDE.md

# scripts/release.ps1 output (contains recompiled game code)
release/
